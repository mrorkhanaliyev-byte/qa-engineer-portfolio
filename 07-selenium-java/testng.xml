<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Default (local) TestNG suite — runs every test across both sites.

  Runs SEQUENTIALLY (no parallel attribute) on purpose: SauceDemo rate-limits
  an IP that logs in many times in a quick burst, and CheckoutTests shares one
  logged-in driver. Serial execution keeps the login rate low and avoids any
  concurrency on that shared session — stability over speed for a demo suite.

  Override at the command line:
    mvn test -Dbrowser=firefox        run on Firefox instead of Chrome
    mvn test -Dheadless=true          run without a visible browser window
    mvn test -DskipAuth=true          skip Demoblaze tests needing a real account
    mvn test -DsuiteXml=testng-ci.xml run the CI suite (SauceDemo only)
-->
<suite name="QA Portfolio — Full" verbose="1">

    <test name="Demoblaze">
        <classes>
            <class name="tests.demoblaze.LoginTests"/>
        </classes>
    </test>

    <test name="SauceDemo">
        <classes>
            <class name="tests.saucedemo.LoginTests"/>
            <class name="tests.saucedemo.CheckoutTests"/>
        </classes>
    </test>

</suite>
